      "ClockLayout",
      "ClockSize",
      "ShowAmPm",
      "BatteryEnabled",
      "BatteryPosition",
      "BatteryIconVisible",
      "BatteryPercentVisible",
      "BatteryIconSize",
      "BatteryTextSize",
      "BackgroundColor",
      "HoursColor",
      "MinutesColor",
      "AmPmColor",
      "AccentColor",
      "DateColor",
      "BatteryIconColor",
      "BatteryTextColor"
    ],
    "resources": {
      "media": []
    }
