{
  "name": "minimal-plus-time",
  "version": "1.0.1",
  "description": "Minimal Plus - customizable, minimal Pebble Time watchface",
  "author": "Your Developer Name",
  "license": "MIT",
  "keywords": [
    "pebble-app",
    "pebble-watchface",
    "basalt"
  ],
  "private": true,
  "dependencies": {
    "@rebble/clay": "^1.1.0"
  },
  "pebble": {
